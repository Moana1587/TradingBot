# Helius RPC Configuration
HELIUS_API_KEY=your_helius_api_key_here

# Optional: Override default RPC endpoints
# RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# WS_ENDPOINT=wss://atlas-mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# COMMITMENT_LEVEL=processed

# Wallet Configuration
WALLET_PRIVATE_KEY=your_base58_encoded_wallet_private_key_here

# Trading Configuration
COPY_PERCENTAGE=1
MIN_TRADING_AMOUNT_SOL=0
MAX_TRADING_AMOUNT_SOL=7
SLIPPAGE_TOLERANCE_PERCENT=1

# Target Wallets (comma-separated)
TARGET_WALLETS=wallet1,wallet2,wallet3

# Health Check Configuration (optional)
# HEALTH_CHECK_INTERVAL_MS=30000
# BLOCKHASH_UPDATE_INTERVAL_MS=60000

# Logging (optional)
# LOG_LEVEL=info
