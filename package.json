{
    "name": "copy-sniper-v2",
    "version": "2.0.0",
    "description": "Optimized and maintainable Solana copy-trading bot for PumpFun tokens",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "pm2:start": "pm2 start ecosystem.config.js",
        "pm2:stop": "pm2 stop copy-sniper-bot",
        "pm2:restart": "pm2 restart copy-sniper-bot",
        "pm2:delete": "pm2 delete copy-sniper-bot",
        "pm2:logs": "pm2 logs copy-sniper-bot",
        "pm2:status": "pm2 status",
        "pm2:monit": "pm2 monit",
        "pm2:save": "pm2 save",
        "pm2:resurrect": "pm2 resurrect",
        "lint": "eslint src",
        "format": "prettier --write \"src/**/*.ts\"",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --coverage --ci"
    },
    "keywords": [
        "solana",
        "pumpfun",
        "copy-trading",
        "sniper-bot"
    ],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^20.11.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.35.0",
        "@typescript-eslint/parser": "^8.35.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-formatter-compact": "^9.0.1",
        "eslint-plugin-prettier": "^5.5.0",
        "jest": "^29.7.0",
        "prettier": "^3.6.0",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@coral-xyz/anchor": "^0.31.1",
        "@coral-xyz/borsh": "^0.31.1",
        "@solana/spl-token": "^0.4.13",
        "@solana/web3.js": "^1.98.2",
        "bs58": "^6.0.0",
        "dotenv": "^16.5.0",
        "ws": "^8.18.2"
    }
}
